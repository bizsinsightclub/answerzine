# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채운다. .env 는 커밋되지 않는다.

# ── LLM 제공자 (config.yaml 의 llm.provider 로 무엇을 쓸지 고른다) ──

# claude_agent 로 쓸 때는 아무 키도 필요 없다. 설치된 Claude Code 구독으로 돈다.

# Gemini API 키 — https://aistudio.google.com/app/apikey 에서 무료 발급
# (웹 화면에서 넣으면 브라우저에만 저장되고 이 파일은 안 써도 된다)
GEMINI_API_KEY=

# Anthropic API 키(종량제) — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# YouTube Data API v3 키 — https://console.cloud.google.com 에서
# 프로젝트 생성 → "YouTube Data API v3" 사용 설정 → 사용자 인증 정보 → API 키
YOUTUBE_API_KEY=

# 1단계부터 사용 (네이버 뉴스 검색 API) — https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
